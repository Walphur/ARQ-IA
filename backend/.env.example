ALLOWED_ORIGINS=https://arq-ia.pro,https://www.arq-ia.pro,http://localhost:3000
MAX_UPLOAD_MB=15
# Limite de llamadas publicas a /calcular por IP (0 = sin limite)
DEMO_RATE_WINDOW_SEC=3600
DEMO_RATE_MAX=30
TESSERACT_CMD=tesseract
DATABASE_URL=sqlite:///./arq_ia.db
SECRET_KEY=change-me
APP_URL=https://arq-ia.pro
FREE_MONTHLY_LIMIT=20
PAID_MONTHLY_LIMIT=500
# Mercado Pago (Argentina / ARS) — Access Token de "Tus integraciones"
MP_ACCESS_TOKEN=
# Opcional: plan creado en MP (POST /preapproval_plan). Si vacio, usa MP_AMOUNT_ARS.
MP_PREAPPROVAL_PLAN_ID=
MP_AMOUNT_ARS=14999
MP_CURRENCY=ARS
MP_REASON=ARQ-IA Plan Pro (mensual)
# Secret del webhook (panel MP → Webhooks). Vacio = no valida firma (solo dev).
MP_WEBHOOK_SECRET=

# Email (Resend) — invitaciones y reset de clave
RESEND_API_KEY=
# Ej: ARQ-IA <noreply@tu-dominio.com>  (en pruebas: ARQ-IA <onboarding@resend.dev>)
EMAIL_FROM=ARQ-IA <onboarding@resend.dev>
APP_NAME=ARQ-IA

# Cache de precios (Google Sheets CSV) y timeout de red
PRECIOS_CACHE_SEGUNDOS=300
SHEETS_TIMEOUT_SEC=12
# PRECIOS_CSV_URL=https://docs.google.com/spreadsheets/.../export?format=csv
