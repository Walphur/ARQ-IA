# URL del backend FastAPI (obligatoria en produccion: debe coincidir con el despliegue real).
# No uses un subdominio api.{sitio} salvo que exista y apunte al mismo servicio.
REACT_APP_API_URL=http://localhost:8000

# Opcional: nombre visible en la UI (default ARC-IA)
# REACT_APP_SITE_NAME=ARC-IA

# Opcional: WhatsApp soporte (solo digitos, sin + ni espacios), ej. 5491112345678
# REACT_APP_SUPPORT_WHATSAPP=
